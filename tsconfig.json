{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "apps/desktop/src/**/*.ts",
    "apps/desktop/tests/**/*.ts",
    "apps/desktop/vite.config.ts",
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts"
  ]
}
